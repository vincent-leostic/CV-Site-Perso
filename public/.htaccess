# Google ne doit voir qu'une seule version du site : tout passe en https.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Page d'erreur générée par nuxt generate
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Fichiers du build et polices, nommés par empreinte : ils ne changent jamais
  <If "%{REQUEST_URI} =~ m#^/_(nuxt|fonts)/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Photo et captures des projets : un mois. Pour publier une nouvelle image
  # sans attendre, changer le nom du fichier. Les PDF et les miniatures,
  # régénérés sous le même nom à chaque build, gardent le cache par défaut.
  <If "%{REQUEST_URI} =~ m#^/(avatar\.jpg|projects/)#">
    Header set Cache-Control "public, max-age=2592000"
  </If>
</IfModule>
